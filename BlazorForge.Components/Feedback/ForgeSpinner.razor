<div class="forge-spinner-container"
     role="status"
     aria-live="polite">

    <span class="@CssClass" aria-hidden="true"></span>

    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <span class="forge-spinner-label">@Label</span>
    }

    <span class="forge-spinner-sr-only">
        @(string.IsNullOrWhiteSpace(Label) ? "Loading" : Label)
    </span>
</div>

@code {
    [Parameter]
    public SpinnerSize Size { get; set; } = SpinnerSize.Medium;

    [Parameter]
    public string? Label { get; set; } = "Loading...";

    private string CssClass =>
        $"forge-spinner forge-spinner-{Size.ToString().ToLowerInvariant()}";
}
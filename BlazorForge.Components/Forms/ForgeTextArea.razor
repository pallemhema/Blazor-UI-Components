@using Microsoft.AspNetCore.Components.Forms
@inherits InputBase<string?>

<div class="forge-text-area">

    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label for="@InputId" class="forge-text-area-label">
            @Label

            @if (Required)
            {
                <span class="forge-text-area-required"
                      aria-hidden="true">*</span>
            }
        </label>
    }

    <textarea id="@InputId"
              class="forge-text-area-input @CssClass"
              placeholder="@Placeholder"
              rows="@Rows"
              disabled="@Disabled"
              readonly="@ReadOnly"
              required="@Required"
              @bind="CurrentValue">
    </textarea>
    @if (EditContext is not null)
    {
        <ValidationMessage For="@ValueExpression" />
    }

</div>

@code {
    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public int Rows { get; set; } = 4;

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public string? Id { get; set; }

    private readonly string _generatedId =
        $"forge-text-area-{Guid.NewGuid():N}";

    private string InputId => Id ?? _generatedId;

    protected override bool TryParseValueFromString(
        string? value,
        out string? result,
        out string? validationErrorMessage)
    {
        result = value;
        validationErrorMessage = null;

        return true;
    }
}
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@if (IsOpen)
{
    <div class="forge-modal-backdrop"
         @onclick="HandleBackdropClick">

        <section class="forge-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="@TitleId"
                 @onclick:stopPropagation="true">

            <header class="forge-modal-header">
                <h2 id="@TitleId">@Title</h2>

                <button type="button"
                        class="forge-modal-close"
                        aria-label="Close dialog"
                        @onclick="CloseAsync">
                    &times;
                </button>
            </header>

            <div class="forge-modal-body">
                @ChildContent
            </div>

            @if (Footer is not null)
            {
                <footer class="forge-modal-footer">
                    @Footer
                </footer>
            }
        </section>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public string Title { get; set; } = "Dialog";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Footer { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public bool CloseOnBackdropClick { get; set; } = true;

    [Parameter]
public bool CloseOnEscape { get; set; } = true;
private bool _listenerRegistered;
    private IJSObjectReference? _module;
    private IJSObjectReference? _escapeHandler;
    private DotNetObjectReference<ForgeModal>? _dotNetReference;

    [JSInvokable]
    public Task HandleEscape()
    {
        if (IsOpen && CloseOnEscape)
        {
            return CloseAsync();
        }

        return Task.CompletedTask;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_listenerRegistered)
        {
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./_content/BlazorForge.Components/forgeModal.js");

                _dotNetReference ??=
                    DotNetObjectReference.Create(this);

                _escapeHandler =
                    await _module.InvokeAsync<IJSObjectReference>(
                        "registerEscapeHandler",
                        _dotNetReference);

                _listenerRegistered = true;
            }
            catch (JSDisconnectedException)
            {
                // The Blazor circuit has disconnected.
            }
        }
        else if (!IsOpen && _listenerRegistered)
        {
            await RemoveEscapeHandlerAsync();
        }
    }
    private async Task RemoveEscapeHandlerAsync()
    {
        if (_escapeHandler is not null)
        {
            try
            {
                await _escapeHandler.InvokeVoidAsync("dispose");
                await _escapeHandler.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser connection is already gone.
            }
            finally
            {
                _escapeHandler = null;
                _listenerRegistered = false;
            }
        }
    }

    private string TitleId { get; } =
        $"forge-modal-title-{Guid.NewGuid():N}";

    private Task CloseAsync()
    {
        return IsOpenChanged.InvokeAsync(false);
    }

    private Task HandleBackdropClick()
    {
        return CloseOnBackdropClick
            ? CloseAsync()
            : Task.CompletedTask;
    }
    public async ValueTask DisposeAsync()
    {
        if (_escapeHandler is not null)
        {
            try
            {
                await _escapeHandler.InvokeVoidAsync("dispose");
                await _escapeHandler.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit has disconnected.
            }
        }

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit has disconnected.
            }
        }

        _dotNetReference?.Dispose();
    }
}
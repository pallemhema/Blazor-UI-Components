@page "/overlays"
@rendermode InteractiveServer

@using BlazorForge.Components.Overlay

<PageTitle>Overlays | BlazorForge</PageTitle>

<div class="forge-component-page">

    @* Page header *@

    <div class="forge-page-header">
        <div>
            <div class="forge-page-eyebrow">COMPONENTS / OVERLAYS</div>

            <h1>Overlays</h1>

            <p>
                Display contextual information and focused interactions
                using reusable modals and tooltips.
            </p>
        </div>
    </div>

    @* Modal introduction *@

    <section class="forge-demo-section">

        <div class="forge-demo-heading">
            <h2>Modal dialog</h2>

            <p>
                Display important information in a dialog that sits
                above the current page.
            </p>
        </div>

        <div class="forge-demo-preview forge-overlay-preview">

            <ForgeButton Variant="ButtonVariant.Primary"
                         OnClick="OpenBasicModal">
                Open modal
            </ForgeButton>

            <span class="forge-example-description">
                Opens a modal with a title, content, and footer.
            </span>

        </div>

    </section>

    @* Confirmation modal *@

    <section class="forge-demo-section">

        <div class="forge-demo-heading">
            <h2>Confirmation dialog</h2>

            <p>
                Ask users to confirm an action before proceeding.
            </p>
        </div>

        <div class="forge-demo-preview forge-overlay-preview">

            <ForgeButton Variant="ButtonVariant.Danger"
                         OnClick="OpenDeleteModal">
                Delete project
            </ForgeButton>

            @if (_deleteResult is not null)
            {
                <p class="forge-overlay-result" role="status">
                    @_deleteResult
                </p>
            }

        </div>

    </section>

    @* Tooltip placements *@

    <section class="forge-demo-section">

        <div class="forge-demo-heading">
            <h2>Tooltip placements</h2>

            <p>
                Display additional information when users hover over
                or focus an element.
            </p>
        </div>

        <div class="forge-demo-preview forge-tooltip-grid">

            <div class="forge-tooltip-example">
                <span class="forge-example-label">Top</span>

                <ForgeTooltip Text="This tooltip appears above the target."
                              Placement="TooltipPlacement.Top">
                    <button type="button" class="forge-tooltip-target">
                        Hover or focus me
                    </button>
                </ForgeTooltip>
            </div>

            <div class="forge-tooltip-example">
                <span class="forge-example-label">Bottom</span>

                <ForgeTooltip Text="This tooltip appears below the target."
                              Placement="TooltipPlacement.Bottom">
                    <button type="button" class="forge-tooltip-target">
                        Hover or focus me
                    </button>
                </ForgeTooltip>
            </div>

            <div class="forge-tooltip-example">
                <span class="forge-example-label">Left</span>

                <ForgeTooltip Text="This tooltip appears to the left."
                              Placement="TooltipPlacement.Left">
                    <button type="button" class="forge-tooltip-target">
                        Hover or focus me
                    </button>
                </ForgeTooltip>
            </div>

            <div class="forge-tooltip-example">
                <span class="forge-example-label">Right</span>

                <ForgeTooltip Text="This tooltip appears to the right."
                              Placement="TooltipPlacement.Right">
                    <button type="button" class="forge-tooltip-target">
                        Hover or focus me
                    </button>
                </ForgeTooltip>
            </div>

        </div>

    </section>

    @* Modal examples *@

    <ForgeModal @bind-IsOpen="_isBasicModalOpen"
                Title="Welcome to BlazorForge"
                CloseOnBackdropClick="true"
                CloseOnEscape="true">

        <ChildContent>
            <p class="forge-modal-description">
                This is a reusable modal dialog. You can place text,
                forms, buttons, or other Razor components inside it.
            </p>

            <div class="forge-modal-info">
                <strong>Did you know?</strong>

                <p>
                    This dialog supports two-way binding, backdrop
                    dismissal, and Escape-key handling.
                </p>
            </div>
        </ChildContent>

        <Footer>
            <ForgeButton Variant="ButtonVariant.Secondary"
                         OnClick="CloseBasicModal">
                Close
            </ForgeButton>
        </Footer>

    </ForgeModal>

    <ForgeModal @bind-IsOpen="_isDeleteModalOpen"
                Title="Delete project?"
                CloseOnBackdropClick="false"
                CloseOnEscape="true">

        <ChildContent>
            <p class="forge-modal-description">
                Are you sure you want to delete this project?
            </p>

            <p class="forge-modal-warning">
                This is a demonstration. No actual project will be deleted.
            </p>
        </ChildContent>

        <Footer>
            <div class="forge-modal-actions">

                <ForgeButton Variant="ButtonVariant.Secondary"
                             OnClick="CancelDelete">
                    Cancel
                </ForgeButton>

                <ForgeButton Variant="ButtonVariant.Danger"
                             OnClick="ConfirmDelete">
                    Confirm deletion
                </ForgeButton>

            </div>
        </Footer>

    </ForgeModal>

</div>

@code {
    private bool _isBasicModalOpen;
    private bool _isDeleteModalOpen;
    private string? _deleteResult;

    private void OpenBasicModal()
    {
        _isBasicModalOpen = true;
    }

    private void CloseBasicModal()
    {
        _isBasicModalOpen = false;
    }

    private void OpenDeleteModal()
    {
        _deleteResult = null;
        _isDeleteModalOpen = true;
    }

    private void CancelDelete()
    {
        _isDeleteModalOpen = false;
    }

    private void ConfirmDelete()
    {
        _isDeleteModalOpen = false;
        _deleteResult = "Demo completed: the confirmation action was triggered.";
    }
}
@using System.ComponentModel.DataAnnotations
@using BlazorForge.Components.Forms
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

<EditForm Model="@Model">
    <DataAnnotationsValidator />
    <ForgeSelect TValue="string"
                 Label="@Label"
                 Placeholder="@Placeholder"
                 Disabled="@Disabled"
                 Options="@Countries"
                 @bind-Value="Model.Country" />
</EditForm>

@code {
    [Parameter]
    public FormModel Model { get; set; } = new();

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private List<ForgeSelectOption<string>> Countries =
    [
        new() { Text = "India", Value = "IN" },
        new() { Text = "Japan", Value = "JP" },
        new() { Text = "United States", Value = "US" }
    ];

    public sealed class FormModel
    {
        [Required(ErrorMessage = "Country is required.")]
        public string? Country { get; set; }
    }
}